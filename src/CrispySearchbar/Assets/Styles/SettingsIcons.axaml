<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Lucide sliders-horizontal（通用）。原件：lucide-icons/lucide@a537cb6 icons/sliders-horizontal.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-general">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Path Data="M10 5H3"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M12 19H3"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M14 3v4"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M16 17v4"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M21 12h-9"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M21 19h-5"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M21 5h-7"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M8 10v4"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M8 12H3"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide palette（外观）。原件：lucide-icons/lucide@a537cb6 icons/palette.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-appearance">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Path Data="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Ellipse Width="1"
                 Height="1"
                 Fill="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="13,6,0,0" />
        <Ellipse Width="1"
                 Height="1"
                 Fill="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="17,10,0,0" />
        <Ellipse Width="1"
                 Height="1"
                 Fill="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="6,12,0,0" />
        <Ellipse Width="1"
                 Height="1"
                 Fill="{DynamicResource TextSecondaryBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="8,7,0,0" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide keyboard（快捷键）。原件：lucide-icons/lucide@a537cb6 icons/keyboard.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-shortcuts">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Rectangle Width="20"
                   Height="16"
                   RadiusX="2"
                   RadiusY="2"
                   Stroke="{DynamicResource TextSecondaryBrush}"
                   StrokeThickness="2"
                   Margin="2,4,2,4"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Path Data="M6 8h.001M10 8h.001M14 8h.001M18 8h.001M8 12h.001M12 12h.001M16 12h.001M7 16h10"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide search（搜索）。原件：lucide-icons/lucide@a537cb6 icons/search.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-search">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Path Data="m21 21-4.34-4.34"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Ellipse Width="16"
                 Height="16"
                 Stroke="{DynamicResource TextSecondaryBrush}"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide layout-list（模式）。原件：lucide-icons/lucide@a537cb6 icons/layout-list.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-modes">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Rectangle Width="7"
                   Height="7"
                   RadiusX="1"
                   RadiusY="1"
                   Stroke="{DynamicResource TextSecondaryBrush}"
                   StrokeThickness="2"
                   Margin="3,3,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" />
        <Rectangle Width="7"
                   Height="7"
                   RadiusX="1"
                   RadiusY="1"
                   Stroke="{DynamicResource TextSecondaryBrush}"
                   StrokeThickness="2"
                   Margin="3,14,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" />
        <Path Data="M14 4h7"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M14 9h7"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M14 15h7"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M14 20h7"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide book-open-text（词典）。原件：lucide-icons/lucide@a537cb6 icons/book-open-text.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-dictionary">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Path Data="M12 5v16"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M16 13h2"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M16 9h2"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M6 13h2"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M6 9h2"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide info（关于）。原件：lucide-icons/lucide@a537cb6 icons/info.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-about">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Ellipse Width="20"
                 Height="20"
                 Stroke="{DynamicResource TextSecondaryBrush}"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        <Path Data="M12 16v-4"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M12 8h.01"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Lucide settings（窗口标题）。原件：lucide-icons/lucide@a537cb6 icons/settings.svg -->
  <DataTemplate x:Key="SettingsIconTemplate-settings">
    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Path Data="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Ellipse Width="6"
                 Height="6"
                 Stroke="{DynamicResource TextSecondaryBrush}"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
      </Grid>
    </Viewbox>
  </DataTemplate>

</ResourceDictionary>
