<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keep Fluent templates and interaction behavior, but own their visible colors.
       Dynamic color references also update detached popups when the app theme changes. -->
  <!-- Buttons: common hover/pressed colors, including Fluent template states. -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{DynamicResource TransparentColor}" />

  <!-- Toggle switches: exactly the same solid accent and hover as the primary button. -->
  <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ToggleSwitchContainerBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{DynamicResource AccentForegroundColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ToggleSwitchContainerBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="{DynamicResource TextPlaceholderColor}" />

  <!-- Choice controls and their detached dropdown surfaces. -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource SearchSurfaceColor}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource SearchSurfaceBorderColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrush" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource SelectionHoverColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{DynamicResource SelectionHoverColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedDisabled" Color="{DynamicResource TransparentColor}" />

  <!-- Text editing, including validation states. -->
  <SolidColorBrush x:Key="TextControlForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource DividerColor}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="SystemControlErrorTextForegroundBrush" Color="{DynamicResource AccentTextColor}" />

  <!-- Lists, menus, tooltips, flyouts and links. -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="{DynamicResource SearchSurfaceColor}" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{DynamicResource SearchSurfaceBorderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{DynamicResource SearchSurfaceColor}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{DynamicResource SearchSurfaceBorderColor}" />
  <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{DynamicResource SearchSurfaceColor}" />
  <SolidColorBrush x:Key="FlyoutPresenterForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="{DynamicResource SearchSurfaceBorderColor}" />
  <!-- Fluent ListBoxItem templates use the shared SystemControl keys directly. -->
  <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{DynamicResource SelectionHoverColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{DynamicResource SelectionHoverColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{DynamicResource SelectionColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackground" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrush" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="{DynamicResource TextPlaceholderColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushDisabled" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundVisited" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundVisited" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushVisited" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPointerOver" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundVisitedPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushVisitedPointerOver" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundVisitedPressed" Color="{DynamicResource LinkColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBackgroundVisitedPressed" Color="{DynamicResource TransparentColor}" />
  <SolidColorBrush x:Key="HyperlinkButtonBorderBrushVisitedPressed" Color="{DynamicResource TransparentColor}" />
</ResourceDictionary>
