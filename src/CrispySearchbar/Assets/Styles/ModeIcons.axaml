    <Viewbox Width="13" Height="13">
      <Grid Width="24" Height="24">
        <Ellipse Width="20"
                 Height="20"
                 Stroke="{DynamicResource TextSecondaryBrush}"
                 StrokeThickness="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        <Path Data="M12 2a14.5 14.5 0 0 0 0 20a14.5 14.5 0 0 0 0-20"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
        <Path Data="M2 12h20"
              Stroke="{DynamicResource TextSecondaryBrush}"
              StrokeThickness="2"
              StrokeLineCap="Round" />
      </Grid>
    </Viewbox>
  </DataTemplate>

