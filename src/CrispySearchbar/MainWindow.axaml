<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrispySearchbar.ViewModels"
        x:Class="CrispySearchbar.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="660"
        Height="360"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="True"
        Title="Crispy Searchbar"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Border CornerRadius="16"
          Background="{DynamicResource SearchSurfaceBrush}"
          BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
          BorderThickness="1"
          BoxShadow="0 10 32 0 #33000000">
    <Grid RowDefinitions="Auto,Auto,*"
          Margin="20,18,20,16">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBox x:Name="QueryBox"
                 Grid.Column="0"
                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{Binding CurrentMode.Watermark}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontSize="20"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 CaretBrush="{DynamicResource AccentBrush}"
                 SelectionBrush="{DynamicResource SelectionBrush}"
                 Padding="2,6"
                 VerticalContentAlignment="Center" />

        <Border Grid.Column="1"
                Margin="14,0,0,0"
                Padding="12,4"
                VerticalAlignment="Center"
                CornerRadius="999"
                Background="{DynamicResource HoverBrush}">
          <TextBlock Text="{Binding CurrentMode.Title}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Height="1"
              Margin="0,10"
              Background="{DynamicResource DividerBrush}" />

      <Grid Grid.Row="2">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Text="{Binding CurrentMode.ActionHint}"
                     FontSize="15"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Tab 切换模式 · Enter 执行 · Esc 退出（开发版）"
                     FontSize="12"
                     Foreground="{DynamicResource TextPlaceholderBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>


