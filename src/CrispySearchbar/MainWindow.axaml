<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrispySearchbar.ViewModels"
        x:Class="CrispySearchbar.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="660"
        Height="88"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Crispy Searchbar"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Border Margin="10,8,10,26"
          Height="54"
          CornerRadius="27"
          Background="{DynamicResource SearchSurfaceBrush}"
          BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
          BorderThickness="1"
          BoxShadow="0 8 22 0 #38000000">
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="QueryBox"
               Grid.Column="0"
               Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="{Binding CurrentMode.Watermark}"
               Background="Transparent"
               BorderThickness="0"
               FontSize="20"
               Foreground="{DynamicResource TextPrimaryBrush}"
               CaretBrush="{DynamicResource AccentBrush}"
               SelectionBrush="{DynamicResource SelectionBrush}"
               Padding="18,0,8,0"
               VerticalContentAlignment="Center" />

      <Border Grid.Column="1"
              Margin="6,0,8,0"
              Padding="12,5"
              VerticalAlignment="Center"
              CornerRadius="999"
              Background="{DynamicResource HoverBrush}">
        <TextBlock Text="{Binding CurrentMode.Title}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>
    </Grid>
  </Border>
</Window>
