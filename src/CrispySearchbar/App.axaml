<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CrispySearchbar.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <!-- Pin Fluent's fallback accent instead of inheriting the Windows accent. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="{DynamicResource AccentColor}" />
        <ColorPaletteResources x:Key="Dark" Accent="{DynamicResource AccentColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <StyleInclude Source="avares://CrispySearchbar/Assets/Styles/Scrollbars.axaml" />
    <!-- Popup 使用独立原生顶层窗口；根层必须透明，否则圆角浮层四角会露出方形底色。 -->
    <Style Selector="PopupRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TransparencyLevelHint" Value="Transparent" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CrispySearchbar/Assets/Styles/Palette.axaml" />
        <ResourceInclude Source="avares://CrispySearchbar/Assets/Styles/FluentColors.axaml" />
        <ResourceInclude Source="avares://CrispySearchbar/Assets/Styles/ModeIcons.axaml" />
        <ResourceInclude Source="avares://CrispySearchbar/Assets/Styles/SettingsIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
