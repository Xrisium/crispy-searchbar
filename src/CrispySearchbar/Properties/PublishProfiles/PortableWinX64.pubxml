<?xml version="1.0" encoding="utf-8"?>
<!--
  便携单文件发布配置：win-x64 自包含单 exe。
  产物除 exe 本身外不包含任何外附文件（词典与第三方声明的文本均内嵌进程序集），
  首次运行只会在 exe 同目录自动生成 settings.json。
  用法：dotnet publish src/CrispySearchbar/CrispySearchbar.csproj -p:PublishProfile=PortableWinX64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia 依赖 SkiaSharp/HarfBuzz/Angle 原生库：单文件必须带上它们，运行时解包到 %TEMP%\.net。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 发布产物不要调试符号。 -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 不吃 trimming / ReadyToRun / NativeAOT：保持 Avalonia XAML 与反射行为的可预测性。 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
