<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrispySearchbar.ViewModels"
        x:Class="CrispySearchbar.NoticesWindow"
        x:DataType="vm:NoticesWindowViewModel"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="{Binding WindowTitle}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

  <Window.Styles>
    <Style Selector="Button.closeButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.closeButton /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.closeButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!--
        文档正文由 NoticesDocumentRenderer 在代码里生成，结构与文本在代码中，
        字号/颜色统一由下面这组样式类提供，保证不出现代码里的魔法色值。
    -->
    <Style Selector="TextBlock.noticesText">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.noticesHeading1">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="700" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.noticesHeading2">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.noticesHeading3">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.noticesTableHeader">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.noticesTableCell">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.noticesPlainText">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <Border Margin="10"
          Background="{DynamicResource SearchSurfaceBrush}"
          BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 10 24 0 #33000000">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="50"
              PointerPressed="OnTitleBarPointerPressed"
              Background="Transparent">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="18,0"
                      VerticalAlignment="Center">
            <ContentControl Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            Content="{Binding WindowTitle}"
                            ContentTemplate="{StaticResource SettingsIconTemplate-about}" />
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="18"
                       FontWeight="700"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Margin="8"
                  Classes="closeButton"
                  Click="OnCloseClicked">
            <Viewbox Width="14" Height="14">
              <Grid Width="24" Height="24">
                <Path Data="M18 6 6 18M6 6l12 12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round" />
              </Grid>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="196,*" Margin="0,2,0,0">
        <Border Grid.Column="0"
                Margin="10,8,0,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
          <ListBox x:Name="DocumentList"
                   ItemsSource="{Binding Documents}"
                   SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                   SelectionChanged="OnDocumentSelectionChanged"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,2,12,0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NoticesDocumentItemViewModel}">
                <TextBlock Text="{Binding Label}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <ScrollViewer x:Name="DocumentScroll"
                      Grid.Column="1"
                      Margin="18,8,0,10"
                      AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Intro}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel x:Name="DocumentHost" Spacing="8" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
