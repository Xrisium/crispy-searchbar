<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrispySearchbar.ViewModels"
        xmlns:converters="using:CrispySearchbar.Converters"
        x:Class="CrispySearchbar.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="780"
        Height="580"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Crispy Searchbar"
        FontFamily="Segoe UI, Microsoft YaHei UI">

  <Window.Resources>
    <converters:SettingsIconTemplateConverter x:Key="SettingsIconTemplateConverter" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBox.settingsTextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox.settingsTextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.settingsComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.closeButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.closeButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ChoiceSettingFieldViewModel}">
      <Border BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                    Classes="settingsComboBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ChoiceOptionViewModel}">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToggleSettingFieldViewModel}">
      <Border BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextSettingFieldViewModel}">
      <Border BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBox Grid.Column="1"
                   Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Classes="settingsTextBox"
                   VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FilePathSettingFieldViewModel}">
      <Border BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,340">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <DockPanel Grid.Column="1" VerticalAlignment="Center">
            <Button DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Classes="secondary"
                    Content="{Binding BrowseText}"
                    Click="OnBrowsePathClicked" />
            <Button DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Classes="secondary"
                    Content="{Binding ClearText}"
                    IsVisible="{Binding HasFilePath}"
                    Click="OnClearPathClicked" />
            <TextBox Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="settingsTextBox" />
          </DockPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Border Margin="10"
          Background="{DynamicResource SearchSurfaceBrush}"
          BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 10 24 0 #33000000">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="50"
              PointerPressed="OnTitleBarPointerPressed"
              Background="Transparent">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding WindowTitle}"
                     Margin="18,0"
                     FontSize="15"
                     FontWeight="600"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Grid.Column="1"
                  Margin="8"
                  Classes="closeButton"
                  Content="×"
                  Click="OnCloseClicked" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Padding="18,10"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Classes="primary"
                  Content="{Binding SaveText}"
                  Click="OnSaveClicked" />
          <StackPanel VerticalAlignment="Center"
                      Spacing="2"
                      Margin="0,0,16,0">
            <TextBlock Text="{Binding ConfigFilePathText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextPlaceholderBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid ColumnDefinitions="176,*"
            Margin="0,2,0,0">
        <Border Grid.Column="0"
                Margin="10,8,0,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
          <ListBox x:Name="CategoryNav"
                   ItemsSource="{Binding Sections}"
                   SelectionChanged="OnCategorySelectionChanged"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,2,12,0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsSectionViewModel}">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ContentControl Width="13"
                                  Height="13"
                                  VerticalAlignment="Center"
                                  Content="{Binding Key}"
                                  ContentTemplate="{Binding Key, Converter={StaticResource SettingsIconTemplateConverter}}" />
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Column="1"
                      Margin="0,4,0,0"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SectionHost"
                        ItemsSource="{Binding Sections}"
                        Margin="4,0,18,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsSectionViewModel}">
                <StackPanel Margin="2,10,0,18"
                            Loaded="OnSectionLoaded">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ContentControl Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Content="{Binding Key}"
                                    ContentTemplate="{Binding Key, Converter={StaticResource SettingsIconTemplateConverter}}" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="600"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <Border Height="1"
                          Margin="0,8,0,12"
                          Background="{DynamicResource DividerBrush}" />
                  <ItemsControl ItemsSource="{Binding Fields}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</Window>
