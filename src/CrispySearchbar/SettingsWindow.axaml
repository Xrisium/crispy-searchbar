<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CrispySearchbar.ViewModels"
        xmlns:converters="using:CrispySearchbar.Converters"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="CrispySearchbar.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="780"
        Height="580"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Crispy Searchbar"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        KeyUp="OnWindowKeyUp">

  <Window.Resources>
    <converters:SettingsIconTemplateConverter x:Key="SettingsIconTemplateConverter" />
    <converters:ModeIconTemplateConverter x:Key="ModeIconTemplateConverter" />
  </Window.Resources>

  <Window.Styles>
    <!--
        settingsTextBox 是设置面板唯一的单行输入样式：文本、文件路径、网址模板、位置偏移等
        所有输入框都必须复用它（规范见 .agents/DESIGN.md「设置面板输入控件规范」）；
        禁止为单个设置项另写输入框样式，也不要改用自带方形焦点框的 NumericUpDown。
    -->
    <Style Selector="TextBox.settingsTextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox.settingsTextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.settingsComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="600" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource PrimaryButtonHoverGlow}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="Button.modeMoveButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.modeMoveButton /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.modeMoveButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.modeMoveButton:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.modeDragHandle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.modeDragHandle:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.modeRowTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="500" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.modeRowTitle:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.shortcutCaptureButton">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="500" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.shortcutCaptureButton /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.shortcutCaptureButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.closeButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.closeButton /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.closeButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.configPathLink">
      <Setter Property="Foreground" Value="{DynamicResource TextPlaceholderBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.configPathLink:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="TextBlock.aboutLink">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.aboutLink:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ChoiceSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding Options}"
                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                    Classes="settingsComboBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ChoiceOptionViewModel}">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToggleSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        OnContent="{Binding ToggleOnText}"
                        OffContent="{Binding ToggleOffText}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,300">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBox Grid.Column="1"
                   Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Classes="settingsTextBox"
                   VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FilePathSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,340">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <DockPanel Grid.Column="1" VerticalAlignment="Center">
            <Button DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Classes="secondary"
                    Content="{Binding BrowseText}"
                    Click="OnBrowsePathClicked" />
            <Button DockPanel.Dock="Right"
                    Margin="6,0,0,0"
                    Classes="secondary"
                    Content="{Binding ClearText}"
                    IsVisible="{Binding HasFilePath}"
                    Click="OnClearPathClicked" />
            <TextBox Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="settingsTextBox" />
          </DockPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShortcutSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,340">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Warning}"
                       IsVisible="{Binding HasWarning}"
                       FontSize="12"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Column="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="6"
                VerticalAlignment="Center">
            <Button Grid.Column="0"
                    Classes="shortcutCaptureButton"
                    HorizontalAlignment="Stretch"
                    Click="OnShortcutCaptureClicked">
              <Grid>
                <TextBlock Text="{Binding CaptureLabel}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           IsVisible="{Binding !IsEmpty}" />
                <TextBlock Text="{Binding CaptureLabel}"
                           Foreground="{DynamicResource TextPlaceholderBrush}"
                           IsVisible="{Binding IsEmpty}" />
              </Grid>
            </Button>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Content="{Binding ResetText}"
                    IsVisible="{Binding !IsDefault}"
                    Click="OnShortcutResetClicked" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:OffsetSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <Grid ColumnDefinitions="*,340">
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Column="1"
                ColumnDefinitions="*,*,Auto"
                ColumnSpacing="6"
                VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Text="{Binding HorizontalLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource TextPlaceholderBrush}" />
              <TextBox Classes="settingsTextBox"
                       Text="{Binding XText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding VerticalLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource TextPlaceholderBrush}" />
              <TextBox Classes="settingsTextBox"
                       Text="{Binding YText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2"
                    Classes="secondary"
                    Margin="0,0,0,1"
                    VerticalAlignment="Bottom"
                    Content="{Binding ResetText}"
                    IsEnabled="{Binding !IsDefault}"
                    Click="OnResetSearchBarPositionClicked" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ModeListSettingFieldViewModel}">
      <Border Loaded="OnSettingFieldLoaded"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,10">
        <StackPanel Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Label}"
                       FontSize="13"
                       FontWeight="500"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}"
                       IsVisible="{Binding HasDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}"
                       IsVisible="{Binding HasError}"
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Border Padding="2"
                  Background="Transparent"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ModeListItemViewModel}">
                  <Border Loaded="OnModeRowLoaded"
                          Padding="2,1"
                          CornerRadius="8">
                    <!--
                        最后一列由内容决定宽度：本地化的开/关标签比固定的 48 DIP 更宽，
                        写死列宽会把标签裁掉（规范见 .agents/DESIGN.md「设置窗口形态」）。
                    -->
                    <Grid ColumnDefinitions="30,*,Auto,Auto,Auto"
                          MinHeight="34">
                      <Border Grid.Column="0"
                              Classes="modeDragHandle"
                              Margin="2,2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              PointerPressed="OnModeDragHandlePointerPressed"
                              ToolTip.Tip="{Binding Owner.ModeDragHandleToolTip}">
                        <Viewbox Width="13" Height="13">
                          <Grid Width="24" Height="24">
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="8,4,0,0" />
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="8,11,0,0" />
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="8,18,0,0" />
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="14,4,0,0" />
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="14,11,0,0" />
                            <Ellipse Width="2"
                                     Height="2"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="14,18,0,0" />
                          </Grid>
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  VerticalAlignment="Center">
                        <ContentControl Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Content="{Binding Key}"
                                        ContentTemplate="{Binding Key, Converter={StaticResource ModeIconTemplateConverter}}" />
                        <TextBlock Text="{Binding Title}"
                                   Classes="modeRowTitle"
                                   IsEnabled="{Binding IsEnabled}" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="modeMoveButton"
                              Margin="0,0,2,0"
                              IsEnabled="{Binding CanMoveUp}"
                              Click="OnModeMoveUpClicked"
                              automation:AutomationProperties.Name="{Binding Owner.ModeMoveUpToolTip}"
                              ToolTip.Tip="{Binding Owner.ModeMoveUpToolTip}">
                        <Viewbox Width="12" Height="12">
                          <Grid Width="24" Height="24">
                            <Path Data="m18 15-6-6-6 6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                          </Grid>
                        </Viewbox>
                      </Button>
                      <Button Grid.Column="3"
                              Classes="modeMoveButton"
                              IsEnabled="{Binding CanMoveDown}"
                              Click="OnModeMoveDownClicked"
                              automation:AutomationProperties.Name="{Binding Owner.ModeMoveDownToolTip}"
                              ToolTip.Tip="{Binding Owner.ModeMoveDownToolTip}">
                        <Viewbox Width="12" Height="12">
                          <Grid Width="24" Height="24">
                            <Path Data="m6 9 6 6 6-6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                          </Grid>
                        </Viewbox>
                      </Button>
                      <ToggleSwitch Grid.Column="4"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    OnContent="{Binding Owner.ToggleOnText}"
                                    OffContent="{Binding Owner.ToggleOffText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShortcutResetAllViewModel}">
      <Border Margin="0,6,0,0"
              Padding="0,6,0,0">
        <Button Classes="secondary"
                Content="{Binding Text}"
                HorizontalAlignment="Left"
                Click="OnResetAllShortcutsClicked" />
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutParagraphViewModel}">
      <Border Padding="0,7">
        <TextBlock Text="{Binding Text}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AboutVersionViewModel}">
      <Border Padding="0,7">
        <TextBlock Text="{Binding Text}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AboutLinkViewModel}">
      <Border Padding="0,7">
        <TextBlock Text="{Binding Label}"
                   Classes="aboutLink"
                   ToolTip.Tip="{Binding Target}"
                   Tapped="OnAboutLinkTapped" />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AboutActionViewModel}">
      <Border Margin="0,6,0,0"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0">
        <StackPanel Spacing="6">
          <Button Classes="secondary"
                  Content="{Binding Text}"
                  HorizontalAlignment="Left"
                  Click="OnResetConfigClicked" />
          <TextBlock Text="{Binding Description}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <!-- 1×1 的焦点承载控件：快捷键录制与“输入框失焦”都把手动焦点放到这里，避免焦点落到某个按钮上。 -->
    <Border x:Name="FocusSinkHost"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            Opacity="0"
            IsHitTestVisible="False"
            Focusable="True" />
  <Border x:Name="SettingsSurface"
          Margin="10"
          Background="{DynamicResource SearchSurfaceBrush}"
          BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 10 24 0 #33000000"
          DragDrop.AllowDrop="True"
          DragDrop.DragOver="OnModeSurfaceDragOver"
          DragDrop.Drop="OnModeSurfaceDrop">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="50"
              PointerPressed="OnTitleBarPointerPressed"
              Background="Transparent">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="18,0"
                      VerticalAlignment="Center">
            <ContentControl Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            Content="{Binding WindowTitle}"
                            ContentTemplate="{StaticResource SettingsIconTemplate-settings}" />
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="18"
                       FontWeight="700"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Margin="8"
                  Classes="closeButton"
                  Click="OnCloseClicked">
            <Viewbox Width="14" Height="14">
              <Grid Width="24" Height="24">
                <Path Data="M18 6 6 18M6 6l12 12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round" />
              </Grid>
            </Viewbox>
          </Button>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Padding="18,10"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,1,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Classes="primary"
                  Content="{Binding SaveText}"
                  Click="OnSaveClicked" />
          <StackPanel VerticalAlignment="Center"
                      Spacing="2"
                      Margin="0,0,16,0">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="{Binding ConfigFileLabel}"
                         FontSize="11"
                         Foreground="{DynamicResource TextPlaceholderBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ConfigFilePath}"
                         Classes="configPathLink"
                         Margin="4,0,0,0"
                         FontSize="11"
                         ToolTip.Tip="{Binding ConfigFileOpenText}"
                         Tapped="OnConfigPathTapped" />
            </Grid>
            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis">
              <TextBlock.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity"
                                    Duration="0:0:0.18" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid ColumnDefinitions="176,*"
            Margin="0,2,0,0">
        <Border Grid.Column="0"
                Margin="10,8,0,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
          <ListBox x:Name="CategoryNav"
                   ItemsSource="{Binding Sections}"
                   SelectionChanged="OnCategorySelectionChanged"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,2,12,0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsSectionViewModel}">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <ContentControl Width="13"
                                  Height="13"
                                  VerticalAlignment="Center"
                                  Content="{Binding Key}"
                                  ContentTemplate="{Binding Key, Converter={StaticResource SettingsIconTemplateConverter}}" />
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Column="1"
                      Margin="8,8,0,0"
                      AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SectionHost"
                        ItemsSource="{Binding Sections}"
                        Margin="16,0,24,20"
                        Background="Transparent">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SettingsSectionViewModel}">
                <StackPanel Margin="2,10,0,18"
                            Loaded="OnSectionLoaded">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ContentControl Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Content="{Binding Key}"
                                    ContentTemplate="{Binding Key, Converter={StaticResource SettingsIconTemplateConverter}}" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="600"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <Border Height="1"
                          Margin="0,8,0,12"
                          Background="{DynamicResource DividerBrush}" />
                  <ItemsControl ItemsSource="{Binding Items}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
    <Border x:Name="ModeDropIndicator"
            IsVisible="False"
            Height="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="18,0,18,0"
            Background="{DynamicResource AccentBrush}"
            CornerRadius="1"
            IsHitTestVisible="False"
            ZIndex="5" />
    <Border IsVisible="{Binding IsResetConfirmationVisible}"
            Background="#66000000"
            ZIndex="1">
      <Border Width="340"
              Padding="22"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SearchSurfaceBrush}"
              BorderBrush="{DynamicResource SearchSurfaceBorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              BoxShadow="0 12 28 0 #40000000">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding ResetConfirmationTitle}"
                     FontSize="15"
                     FontWeight="600"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ResetConfirmationMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Classes="secondary"
                    Content="{Binding ResetConfirmationCancelText}"
                    Click="OnResetCancelledClicked" />
            <Button Classes="primary"
                    Content="{Binding ResetConfirmationAcceptText}"
                    Click="OnResetConfirmedClicked" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
